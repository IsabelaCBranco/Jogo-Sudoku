; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="sudoku"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/run/main_scene="res://scenes/main_menu/main_menu.tscn"

[autoload]

GameSettings="*res://scripts/systems/game_settings.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
StatisticsSystem="*res://scripts/systems/statistics_system.gd"
HintProgression="*res://scripts/systems/hint_progression.gd"
GameSession="*res://scripts/game/game_session.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/viewport_width=1280
window/size/viewport_height=720

[gui]

theme/custom="res://theme/theme.tres"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

environment/defaults/default_clear_color=Color(0.09, 0.11, 0.16, 1)
rendering_device/driver.windows="d3d12"
